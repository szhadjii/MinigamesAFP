# Copy to .env (never commit .env). Without LLM_PROVIDER the app uses the built-in fallback content.
SECRET_KEY=change-me

# "anthropic", "openai" (any OpenAI-compatible API) or "none"
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Only for "openai", e.g. http://localhost:11434/v1 (Ollama) or https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_TIMEOUT=20
LLM_MAX_ATTEMPTS=3
